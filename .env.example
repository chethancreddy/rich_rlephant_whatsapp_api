# ============================================================================
# Environment Configuration Template
# Brand: Rich Rlephant Marketing Whatsapp API
# ============================================================================

# Platform Identity & Host
NEXT_PUBLIC_APP_NAME="Rich Rlephant Marketing Whatsapp API"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

# Supabase Auth, Storage & PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres"

# Cryptographic Master Key for Envelope Encryption (32-byte hex for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Meta WhatsApp Cloud API Configuration
META_GRAPH_API_VERSION="v21.0"
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_WEBHOOK_VERIFY_TOKEN="your-secure-webhook-verify-token"

# Worker Pacing & Concurrency Controls
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1000

